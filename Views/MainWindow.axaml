<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CursoAvalonia.ViewModels"
        xmlns:models="using:CursoAvalonia.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="760"
        x:Class="CursoAvalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icone4.ico"
        Title="PDV DO AGIOTA"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="680"
        Background="#F6F6F6">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- ===================================================== -->
    <!-- ESTILOS                                               -->
    <!-- ===================================================== -->

    <Window.Styles>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#171717"/>
            <Setter Property="BorderBrush" Value="#D6D6D6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="#FFF8D6"/>
            <Setter Property="BorderBrush" Value="#FFC400"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#171717"/>
            <Setter Property="BorderBrush" Value="#D6D6D6"/>
        </Style>

        <Style Selector="ComboBox:focus">
            <Setter Property="Background" Value="#FFF8D6"/>
            <Setter Property="BorderBrush" Value="#FFC400"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="AutoCompleteBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#171717"/>
            <Setter Property="BorderBrush" Value="#D6D6D6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="AutoCompleteBox:focus">
            <Setter Property="Background" Value="#FFF8D6"/>
            <Setter Property="BorderBrush" Value="#FFC400"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

    </Window.Styles>

    <!-- ===================================================== -->
    <!-- ESTRUTURA PRINCIPAL                                   -->
    <!-- ===================================================== -->

    <Grid RowDefinitions="58,*">

        <!-- ================================================= -->
        <!-- CABEÇALHO                                         -->
        <!-- ================================================= -->

        <Border
            Grid.Row="0"
            Background="#171717"
            Padding="20,0">

            <Grid ColumnDefinitions="*,Auto">

                <!-- LOGO / NOME -->

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="▣"
                        Foreground="#FFC400"
                        FontSize="23"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Text="PDV DO AGIOTA"
                        Foreground="#FFC400"
                        FontSize="21"
                        FontWeight="Bold"
                        VerticalAlignment="Center"/>

                </StackPanel>

                <!-- LADO DIREITO -->

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Caixa: ABERTO  |  Operador: Admin"
                        Foreground="White"
                        FontSize="13"
                        VerticalAlignment="Center"/>

                    <Button
                        Content="CONFIGURAÇÃO"
                        Height="34"
                        Padding="14,0"
                        Background="#FFC400"
                        Foreground="#171717"
                        FontWeight="Bold"
                        CornerRadius="5"
                        Click="Configuracao_Click"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- CONTEÚDO                                          -->
        <!-- ================================================= -->

        <Grid
            Grid.Row="1"
            Margin="14"
            RowDefinitions="Auto,*"
            RowSpacing="12">

            <!-- ================================================= -->
            <!-- BARRA DO PEDIDO                                   -->
            <!-- ================================================= -->

            <Border
                Grid.Row="0"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12">

                <Grid
                    ColumnDefinitions="Auto,90,280,100,105,*,Auto"
                    ColumnSpacing="10">

                    <TextBlock
                        Grid.Column="0"
                        Text="Pedido"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#171717"
                        VerticalAlignment="Center"/>

                    <Button
                        Grid.Column="1"
                        Content="NOVO"
                        Height="34"
                        Background="#171717"
                        Foreground="#FFC400"
                        FontWeight="Bold"
                        CornerRadius="5"
                        Command="{Binding NovoPedidoCommand}"/>

                    <AutoCompleteBox
                        x:Name="txtPedido"
                        Grid.Column="2"
                        ItemsSource="{Binding Pedidos}"
                        SelectedItem="{Binding PedidoSelecionado}"
                        ValueMemberBinding="{Binding NumeroPedido}"
                        MinimumPrefixLength="0"
                        FilterMode="Contains"
                        IsTextCompletionEnabled="True"
                        PlaceholderText="Digite o número do pedido...">

                        <AutoCompleteBox.ItemTemplate>

                            <DataTemplate x:DataType="models:Pedido">

                                <Grid
                                    ColumnDefinitions="70,*,90"
                                    ColumnSpacing="10">

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding NumeroPedido}"
                                        FontWeight="Bold"
                                        Foreground="#171717"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Data}"
                                        Foreground="#777777"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding SubTotal}"
                                        HorizontalAlignment="Right"
                                        FontWeight="SemiBold"
                                        Foreground="#171717"/>

                                </Grid>

                            </DataTemplate>

                        </AutoCompleteBox.ItemTemplate>

                    </AutoCompleteBox>

                    <Button
                        Grid.Column="3"
                        Content="ALTERAR"
                        Height="34"
                        Background="#FFC400"
                        Foreground="#171717"
                        FontWeight="Bold"
                        CornerRadius="5"
                        Command="{Binding AlterarPedidoCommand}"/>

                    <Button
                        Grid.Column="4"
                        Content="CANCELAR"
                        Height="34"
                        Background="#D32F2F"
                        Foreground="White"
                        FontWeight="Bold"
                        CornerRadius="5"
                        Command="{Binding CancelarPedidoCommand}"/>

                    <Grid Grid.Column="5"/>

                    <Border
                        Grid.Column="6"
                        Background="{Binding CorStatusPedido}"
                        BorderBrush="{Binding CorStatusPedido}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16,7"
                        MinWidth="125"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="{Binding StatusPedido}"
                            Foreground="White"
                            FontSize="12"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>

                </Grid>

            </Border>

            <!-- ================================================= -->
            <!-- ÁREA PRINCIPAL                                    -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="1"
                ColumnDefinitions="1.35*,1*"
                ColumnSpacing="14">

                <!-- ================================================= -->
                <!-- COLUNA ESQUERDA                                   -->
                <!-- ================================================= -->

                <Grid
                    Grid.Column="0"
                    RowDefinitions="Auto,Auto,*,Auto"
                    RowSpacing="12">

                    <!-- CLIENTE -->

                    <Border
                        Grid.Row="0"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="16">

                        <StackPanel Spacing="9">

                            <TextBlock
                                Text="Cliente"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#171717"/>

                            <Grid
                                ColumnDefinitions="*,46"
                                ColumnSpacing="8">

                                <AutoCompleteBox
                                    Grid.Column="0"
                                    ItemsSource="{Binding Clientes}"
                                    SelectedItem="{Binding ClienteSelecionado}"
                                    ValueMemberBinding="{Binding Nome}"
                                    MinimumPrefixLength="0"
                                    FilterMode="Contains"
                                    IsTextCompletionEnabled="True"
                                    IsEnabled="{Binding PodeEditar}"
                                    PlaceholderText="Digite o nome do cliente...">

                                    <AutoCompleteBox.ItemTemplate>

                                        <DataTemplate x:DataType="models:Cliente">

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="8">

                                                <TextBlock
                                                    Text="{Binding Id}"
                                                    Foreground="#888888"/>

                                                <TextBlock
                                                    Text="{Binding Nome}"
                                                    FontWeight="SemiBold"
                                                    Foreground="#171717"/>

                                            </StackPanel>

                                        </DataTemplate>

                                    </AutoCompleteBox.ItemTemplate>

                                </AutoCompleteBox>

                                <Button
                                    Grid.Column="1"
                                    Content="+"
                                    Background="#FFC400"
                                    Foreground="#171717"
                                    FontSize="21"
                                    FontWeight="Bold"
                                    CornerRadius="5"
                                    IsEnabled="{Binding PodeEditar}"/>

                            </Grid>

                        </StackPanel>

                    </Border>

                    <!-- PRODUTO -->

                    <Border
                        Grid.Row="1"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="16">

                        <StackPanel Spacing="11">

                            <TextBlock
                                Text="Produto"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#171717"/>

                            <!-- CÓDIGO + MERCADORIA -->

                            <Grid
                                ColumnDefinitions="170,*"
                                ColumnSpacing="10">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        Text="Código / Cód. Barras"
                                        FontSize="11"
                                        Foreground="#555555"/>

                                    <AutoCompleteBox
                                        x:Name="txtCodigo"
                                        Text="{Binding Codigo}"
                                        ItemsSource="{Binding Produtos}"
                                        SelectedItem="{Binding ProdutoSelecionado}"
                                        ValueMemberBinding="{Binding Codigo}"
                                        MinimumPrefixLength="0"
                                        FilterMode="Contains"
                                        IsTextCompletionEnabled="True"
                                        IsEnabled="{Binding PodeEditar}"
                                        PlaceholderText="Digite o código..."
                                        KeyDown="Codigo_KeyDown"
                                        TabIndex="1">

                                        <AutoCompleteBox.ItemTemplate>

                                            <DataTemplate x:DataType="models:Produto">

                                                <Grid
                                                    ColumnDefinitions="55,*"
                                                    ColumnSpacing="8">

                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Text="{Binding Codigo}"
                                                        FontWeight="Bold"
                                                        Foreground="#171717"/>

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding Descricao}"
                                                        Foreground="#555555"/>

                                                </Grid>

                                            </DataTemplate>

                                        </AutoCompleteBox.ItemTemplate>

                                    </AutoCompleteBox>

                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="4">

                                    <TextBlock
                                        Text="Mercadoria"
                                        FontSize="11"
                                        Foreground="#555555"/>

                                    <AutoCompleteBox
                                        x:Name="txtMercadoria"
                                        ItemsSource="{Binding Produtos}"
                                        SelectedItem="{Binding ProdutoSelecionado}"
                                        ValueMemberBinding="{Binding Descricao}"
                                        MinimumPrefixLength="0"
                                        FilterMode="Contains"
                                        IsTextCompletionEnabled="True"
                                        IsEnabled="{Binding PodeEditar}"
                                        PlaceholderText="Digite ou selecione a mercadoria..."
                                        TabIndex="2">

                                        <AutoCompleteBox.ItemTemplate>

                                            <DataTemplate x:DataType="models:Produto">

                                                <Grid
                                                    ColumnDefinitions="60,*,Auto"
                                                    ColumnSpacing="10">

                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Text="{Binding Codigo}"
                                                        Foreground="#777777"/>

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding Descricao}"
                                                        FontWeight="SemiBold"
                                                        Foreground="#171717"/>

                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{Binding Valor}"
                                                        Foreground="#777777"/>

                                                </Grid>

                                            </DataTemplate>

                                        </AutoCompleteBox.ItemTemplate>

                                    </AutoCompleteBox>

                                </StackPanel>

                            </Grid>

                            <!-- DESCRIÇÃO -->

                            <StackPanel Spacing="4">

                                <TextBlock
                                    Text="Descrição / Pesquisa"
                                    FontSize="11"
                                    Foreground="#555555"/>

                                <AutoCompleteBox
                                    x:Name="txtDescricao"
                                    Text="{Binding Descricao}"
                                    ItemsSource="{Binding Produtos}"
                                    SelectedItem="{Binding ProdutoSelecionado}"
                                    ValueMemberBinding="{Binding Descricao}"
                                    MinimumPrefixLength="1"
                                    FilterMode="Contains"
                                    IsTextCompletionEnabled="True"
                                    IsEnabled="{Binding PodeEditar}"
                                    PlaceholderText="Digite parte do nome do produto..."
                                    TabIndex="3">

                                    <AutoCompleteBox.ItemTemplate>

                                        <DataTemplate x:DataType="models:Produto">

                                            <Grid
                                                ColumnDefinitions="60,*,100"
                                                ColumnSpacing="8">

                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{Binding Codigo}"
                                                    Foreground="#777777"/>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding Descricao}"
                                                    FontWeight="SemiBold"
                                                    Foreground="#171717"/>

                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="{Binding Valor}"
                                                    HorizontalAlignment="Right"/>

                                            </Grid>

                                        </DataTemplate>

                                    </AutoCompleteBox.ItemTemplate>

                                </AutoCompleteBox>

                            </StackPanel>

                            <!-- QUANTIDADE / VALOR / INSERIR -->

                            <Grid
                                ColumnDefinitions="120,140,*,120"
                                ColumnSpacing="10">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        Text="Quantidade"
                                        FontSize="11"
                                        Foreground="#555555"/>

                                    <TextBox
                                        x:Name="txtQuantidade"
                                        Text="{Binding Quantidade}"
                                        IsEnabled="{Binding PodeEditar}"
                                        KeyDown="Decimal_KeyDown"
                                        TabIndex="4"/>

                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Spacing="4">

                                    <TextBlock
                                        Text="Preço Unit."
                                        FontSize="11"
                                        Foreground="#555555"/>

                                    <TextBox
                                        Text="{Binding Valor}"
                                        IsReadOnly="True"/>

                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    Spacing="4">

                                    <TextBlock
                                        Text="Valor Unitário Selecionado"
                                        FontSize="11"
                                        Foreground="#555555"/>

                                    <Border
                                        Height="34"
                                        Background="#FFF8D6"
                                        BorderBrush="#FFC400"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,0">

                                        <TextBlock
                                            Text="{Binding Valor}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="#171717"/>

                                    </Border>

                                </StackPanel>

                                <Button
                                    x:Name="btnAdicionar"
                                    Grid.Column="3"
                                    Content="INSERIR"
                                    Height="34"
                                    VerticalAlignment="Bottom"
                                    Background="#FFC400"
                                    Foreground="#171717"
                                    FontWeight="Bold"
                                    CornerRadius="5"
                                    TabIndex="5"
                                    IsEnabled="{Binding PodeEditar}"
                                    Command="{Binding AdicionarItemCommand}"/>

                            </Grid>

                        </StackPanel>

                    </Border>

                    <Grid Grid.Row="2"/>

                    <!-- PAGAMENTO -->

                    <Border
                        Grid.Row="3"
                        Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="16">

                        <StackPanel Spacing="9">

                            <TextBlock
                                Text="Pagamento"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#171717"/>

                            <Grid
                                ColumnDefinitions="1.3*,*,*,*"
                                ColumnSpacing="10">

                                <StackPanel Grid.Column="0">

                                    <TextBlock
                                        Text="Forma de Pagamento"
                                        FontSize="11"
                                        Foreground="#555555"/>

                                    <ComboBox
                                        ItemsSource="{Binding FormasPagamento}"
                                        SelectedItem="{Binding FormaPagamento}"
                                        IsEnabled="{Binding PodeEditar}"/>

                                </StackPanel>

                                <StackPanel Grid.Column="1">

                                    <TextBlock
                                        Text="Valor Pago"
                                        FontSize="11"
                                        Foreground="#555555"/>

                                    <TextBox
                                        x:Name="txtValorPago"
                                        Text="{Binding ValorPago}"
                                        IsEnabled="{Binding PodeEditar}"
                                        KeyDown="Decimal_KeyDown"/>

                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <TextBlock
                                        Text="Desconto"
                                        FontSize="11"
                                        Foreground="#555555"/>

                                    <TextBox
                                        Text="{Binding Desconto}"
                                        IsEnabled="{Binding PodeEditar}"
                                        KeyDown="Decimal_KeyDown"/>

                                </StackPanel>

                                <StackPanel Grid.Column="3">

                                    <TextBlock
                                        Text="Troco"
                                        FontSize="11"
                                        Foreground="#555555"/>

                                    <Border
                                        Height="34"
                                        Background="#FFF8D6"
                                        BorderBrush="#FFC400"
                                        BorderThickness="1"
                                        CornerRadius="4">

                                        <TextBlock
                                            Text="{Binding Troco}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="10,0"
                                            FontWeight="Bold"
                                            FontSize="15"
                                            Foreground="#171717"/>

                                    </Border>

                                </StackPanel>

                            </Grid>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- ================================================= -->
                <!-- COLUNA DIREITA                                    -->
                <!-- ================================================= -->

                <Border
                    Grid.Column="1"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="9">

                    <Grid RowDefinitions="Auto,*,Auto">

                        <Grid
                            Grid.Row="0"
                            Margin="14"
                            ColumnDefinitions="*,Auto">

                            <TextBlock
                                Grid.Column="0"
                                Text="Itens da Venda"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#171717"
                                VerticalAlignment="Center"/>

                            <Button
                                Grid.Column="1"
                                Content="Remover Item"
                                Background="#FFC400"
                                Foreground="#171717"
                                FontWeight="SemiBold"
                                IsEnabled="{Binding PodeEditar}"
                                Command="{Binding RemoverItemCommand}"/>

                        </Grid>

                        <!-- DATAGRID -->

                        <DataGrid
                            Grid.Row="1"
                            ItemsSource="{Binding Itens}"
                            SelectedItem="{Binding ItemSelecionado}"
                            AutoGenerateColumns="False"
                            BorderThickness="0"
                            GridLinesVisibility="Horizontal"
                            IsEnabled="{Binding PodeEditar}">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="Cód."
                                    Binding="{Binding Codigo}"
                                    Width="70"
                                    IsReadOnly="True"/>

                                <DataGridTextColumn
                                    Header="Descrição"
                                    Binding="{Binding Descricao}"
                                    Width="*"
                                    IsReadOnly="True"/>

                                <DataGridTextColumn
                                    Header="Qtd"
                                    Binding="{Binding Quantidade}"
                                    Width="70"/>

                                <DataGridTextColumn
                                    Header="Valor"
                                    Binding="{Binding Valor}"
                                    Width="90"/>

                                <DataGridTextColumn
                                    Header="Total"
                                    Binding="{Binding Total}"
                                    Width="100"
                                    IsReadOnly="True"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <!-- TOTALIZADORES -->

                        <Border
                            Grid.Row="2"
                            Background="White"
                            BorderBrush="#E2E2E2"
                            BorderThickness="1,1,1,0"
                            Padding="18">

                            <StackPanel Spacing="11">

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="TOTAL"
                                        Foreground="#171717"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Total}"
                                        Foreground="#171717"
                                        FontSize="16"
                                        FontWeight="Bold"/>

                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="DESCONTO"
                                        Foreground="#D32F2F"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Desconto}"
                                        Foreground="#D32F2F"
                                        FontSize="16"
                                        FontWeight="Bold"/>

                                </Grid>

                                <Border
                                    Height="1"
                                    Background="#DDDDDD"
                                    Margin="0,3"/>

                                <Border
                                    Background="#FFF8D6"
                                    BorderBrush="#FFC400"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="TOTAL DA VENDA"
                                            Foreground="#171717"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding SubTotal}"
                                            Foreground="#171717"
                                            FontSize="25"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center"/>

                                    </Grid>

                                </Border>

                                <Button
                                    Content="FINALIZAR VENDA"
                                    Height="48"
                                    Background="#FFC400"
                                    Foreground="#171717"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    CornerRadius="6"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    IsVisible="{Binding PodeFinalizarNovaVenda}"
                                    Command="{Binding FinalizarVendaCommand}"/>

                                <Button
                                    Content="SALVAR ALTERAÇÕES"
                                    Height="48"
                                    Background="#16A34A"
                                    Foreground="White"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    CornerRadius="6"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    IsVisible="{Binding EmAlteracao}"
                                    Command="{Binding SalvarAlteracoesCommand}"/>

                                <TextBlock
                                    Text="{Binding Mensagem}"
                                    Foreground="#444444"
                                    TextWrapping="Wrap"
                                    HorizontalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>
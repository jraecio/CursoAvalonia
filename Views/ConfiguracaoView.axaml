<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CursoAvalonia.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="760"
             x:Class="CursoAvalonia.Views.ConfiguracaoView"
             x:DataType="vm:ConfiguracaoViewModel">

    <Design.DataContext>
        <vm:ConfiguracaoViewModel />
    </Design.DataContext>

    <Grid Background="#F6F6F6">

        <ScrollViewer>
            <StackPanel Margin="20"
                        Spacing="14">

                <!-- ================================================= -->
                <!-- CABEÇALHO                                         -->
                <!-- ================================================= -->

                <Border Background="#171717"
                        CornerRadius="8"
                        Padding="18">

                    <Grid ColumnDefinitions="*,Auto">

                        <StackPanel>

                            <TextBlock Text="CONFIGURAÇÃO DO SISTEMA"
                                       Foreground="#FFC400"
                                       FontSize="21"
                                       FontWeight="Bold"/>

                            <TextBlock Text="SoftcomShop V2"
                                       Foreground="White"
                                       FontSize="12"
                                       Margin="0,4,0,0"/>

                        </StackPanel>


                        <Border Grid.Column="1"
                                Background="{Binding CorStatusApi}"
                                CornerRadius="6"
                                Padding="14,7"
                                VerticalAlignment="Center">

                            <TextBlock Text="{Binding StatusApi}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="12"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- VINCULAÇÃO                                        -->
                <!-- ================================================= -->

                <Border Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="18">

                    <StackPanel Spacing="12">

                        <TextBlock Text="Vinculação do Dispositivo"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#171717"/>


                        <!-- URL -->

                        <StackPanel Spacing="4">

                            <TextBlock Text="URL de Vinculação"
                                       FontSize="11"
                                       Foreground="#555555"/>

                            <Grid ColumnDefinitions="*,160"
                                  ColumnSpacing="10">

                                <TextBox Grid.Column="0"
                                         Text="{Binding UrlDispositivo}"
                                         Watermark="Cole a URL do dispositivo..."/>

                                <Button Grid.Column="1"
                                        Content="PROCESSAR URL"
                                        Background="#FFC400"
                                        Foreground="#171717"
                                        FontWeight="Bold"
                                        Command="{Binding ProcessarUrlCommand}"/>

                            </Grid>

                        </StackPanel>


                        <!-- BASE URL -->

                        <StackPanel Spacing="4">

                            <TextBlock Text="Base URL"
                                       FontSize="11"
                                       Foreground="#555555"/>

                            <TextBox Text="{Binding BaseUrl}"
                                     IsReadOnly="True"/>

                        </StackPanel>


                        <!-- EMPRESA / CNPJ -->

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">

                            <StackPanel Grid.Column="0"
                                        Spacing="4">

                                <TextBlock Text="Empresa"
                                           FontSize="11"
                                           Foreground="#555555"/>

                                <TextBox Text="{Binding EmpresaNome}"/>

                            </StackPanel>


                            <StackPanel Grid.Column="1"
                                        Spacing="4">

                                <TextBlock Text="CNPJ"
                                           FontSize="11"
                                           Foreground="#555555"/>

                                <TextBox Text="{Binding EmpresaCnpj}"/>

                            </StackPanel>

                        </Grid>


                        <!-- DEVICE NAME / DEVICE ID -->

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">

                            <StackPanel Grid.Column="0"
                                        Spacing="4">

                                <TextBlock Text="Nome do Dispositivo"
                                           FontSize="11"
                                           Foreground="#555555"/>

                                <TextBox Text="{Binding DeviceName}"/>

                            </StackPanel>


                            <StackPanel Grid.Column="1"
                                        Spacing="4">

                                <TextBlock Text="Device ID"
                                           FontSize="11"
                                           Foreground="#555555"/>

                                <TextBox Text="{Binding DeviceId}"
                                         Watermark="Informe o identificador do dispositivo"/>

                            </StackPanel>

                        </Grid>


                        <!-- CLIENT ID -->

                        <StackPanel Spacing="4">

                            <TextBlock Text="Client ID"
                                       FontSize="11"
                                       Foreground="#555555"/>

                            <TextBox Text="{Binding ClientId}"/>

                        </StackPanel>


                        <!-- CLIENT SECRET -->

                        <StackPanel Spacing="4">

                            <TextBlock Text="Client Secret"
                                       FontSize="11"
                                       Foreground="#555555"/>

                            <TextBox Text="{Binding ClientSecret}"
                                     PasswordChar="●"/>

                        </StackPanel>


                        <!-- BOTÕES -->

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">

                            <Button Grid.Column="0"
                                    Content="VINCULAR DISPOSITIVO"
                                    Height="42"
                                    Background="#171717"
                                    Foreground="#FFC400"
                                    FontWeight="Bold"
                                    Command="{Binding VincularDispositivoCommand}"/>

                            <Button Grid.Column="1"
                                    Content="TESTAR AUTENTICAÇÃO"
                                    Height="42"
                                    Background="#2563EB"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Command="{Binding TestarAutenticacaoCommand}"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- TOKEN                                             -->
                <!-- ================================================= -->

                <Border Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="18">

                    <StackPanel Spacing="8">

                        <TextBlock Text="Autenticação"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#171717"/>

                        <TextBlock Text="Token recebido"
                                   FontSize="11"
                                   Foreground="#555555"/>

                        <TextBox Text="{Binding Token}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="65"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- SQL SERVER - VISUAL POR ENQUANTO                  -->
                <!-- ================================================= -->

                <Border Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="18">

                    <StackPanel Spacing="12">

                        <TextBlock Text="SQL Server"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#171717"/>

                        <TextBlock Text="Configuração da conexão com o banco SQL Server."
                                   FontSize="12"
                                   Foreground="#777777"/>


                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">

                            <StackPanel Grid.Column="0"
                                        Spacing="4">

                                <TextBlock Text="Servidor"
                                           FontSize="11"
                                           Foreground="#555555"/>

                                <TextBox Watermark="Ex.: SERVIDOR\SQL2019"/>

                            </StackPanel>


                            <StackPanel Grid.Column="1"
                                        Spacing="4">

                                <TextBlock Text="Banco"
                                           FontSize="11"
                                           Foreground="#555555"/>

                                <TextBox Watermark="Nome do banco"/>

                            </StackPanel>

                        </Grid>


                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">

                            <StackPanel Grid.Column="0"
                                        Spacing="4">

                                <TextBlock Text="Usuário"
                                           FontSize="11"
                                           Foreground="#555555"/>

                                <TextBox Watermark="Usuário SQL"/>

                            </StackPanel>


                            <StackPanel Grid.Column="1"
                                        Spacing="4">

                                <TextBlock Text="Senha"
                                           FontSize="11"
                                           Foreground="#555555"/>

                                <TextBox PasswordChar="●"/>

                            </StackPanel>

                        </Grid>


                        <Button Content="TESTAR CONEXÃO SQL"
                                Height="40"
                                Width="190"
                                HorizontalAlignment="Right"
                                Background="#E5E7EB"
                                Foreground="#171717"
                                FontWeight="Bold"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- MENSAGEM                                          -->
                <!-- ================================================= -->

                <Border Background="#FFF8D6"
                        BorderBrush="#FFC400"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12">

                    <TextBlock Text="{Binding Mensagem}"
                               Foreground="#171717"
                               TextWrapping="Wrap"/>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CursoAvalonia.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="820"
             d:DesignHeight="650"
             x:Class="CursoAvalonia.Views.ConfiguracaoView"
             x:DataType="vm:ConfiguracaoViewModel">

    <Design.DataContext>
        <vm:ConfiguracaoViewModel />
    </Design.DataContext>


    <!-- ===================================================== -->
    <!-- ESTILOS                                               -->
    <!-- ===================================================== -->

    <UserControl.Styles>

        <Style Selector="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#171717"/>
            <Setter Property="BorderBrush" Value="#D6D6D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#171717"/>
            <Setter Property="BorderBrush" Value="#D6D6D6"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </UserControl.Styles>


    <!-- ===================================================== -->
    <!-- CONTEÚDO                                              -->
    <!-- ===================================================== -->

    <Grid Background="#F4F4F4">

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Margin="14"
                Spacing="10">


                <!-- ================================================= -->
                <!-- CABEÇALHO                                         -->
                <!-- ================================================= -->

                <Border
                    Background="#171717"
                    CornerRadius="7"
                    Padding="14,10">

                    <Grid ColumnDefinitions="*,Auto">

                        <StackPanel>

                            <TextBlock
                                Text="CONFIGURAÇÃO"
                                Foreground="#FFC400"
                                FontSize="18"
                                FontWeight="Bold"/>

                            <TextBlock
                                Text="API SoftcomShop V2 e SQL Server"
                                Foreground="#CCCCCC"
                                FontSize="11"
                                Margin="0,2,0,0"/>

                        </StackPanel>


                        <Border
                            Grid.Column="1"
                            Background="{Binding CorStatusApi}"
                            CornerRadius="5"
                            Padding="10,5"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="{Binding StatusApi}"
                                Foreground="White"
                                FontSize="10"
                                FontWeight="Bold"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- SOFTCOMSHOP API                                   -->
                <!-- ================================================= -->

                <Border
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="14">

                    <StackPanel Spacing="8">

                        <TextBlock
                            Text="SoftcomShop V2"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="#171717"/>


                        <!-- URL -->

                        <Grid
                            ColumnDefinitions="*,135"
                            ColumnSpacing="8">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Text="URL de Vinculação"
                                    FontSize="10"
                                    Foreground="#555555"/>

                                <TextBox
                                    Text="{Binding UrlDispositivo}"/>

                            </StackPanel>


                            <Button
                                Grid.Column="1"
                                Content="PROCESSAR URL"
                                VerticalAlignment="Bottom"
                                Background="#FFC400"
                                Foreground="#171717"
                                Command="{Binding ProcessarUrlCommand}"/>

                        </Grid>


                        <!-- BASE URL -->

                        <StackPanel Spacing="3">

                            <TextBlock
                                Text="Base URL"
                                FontSize="10"
                                Foreground="#555555"/>

                            <TextBox
                                Text="{Binding BaseUrl}"
                                IsReadOnly="True"/>

                        </StackPanel>


                        <!-- EMPRESA / CNPJ -->

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="8">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Text="Empresa"
                                    FontSize="10"
                                    Foreground="#555555"/>

                                <TextBox
                                    Text="{Binding EmpresaNome}"/>

                            </StackPanel>


                            <StackPanel
                                Grid.Column="1"
                                Spacing="3">

                                <TextBlock
                                    Text="CNPJ"
                                    FontSize="10"
                                    Foreground="#555555"/>

                                <TextBox
                                    Text="{Binding EmpresaCnpj}"/>

                            </StackPanel>

                        </Grid>


                        <!-- DEVICE NAME / DEVICE ID -->

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="8">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Text="Nome do Dispositivo"
                                    FontSize="10"
                                    Foreground="#555555"/>

                                <TextBox
                                    Text="{Binding DeviceName}"/>

                            </StackPanel>


                            <StackPanel
                                Grid.Column="1"
                                Spacing="3">

                                <TextBlock
                                    Text="Device ID"
                                    FontSize="10"
                                    Foreground="#555555"/>

                                <TextBox
                                    Text="{Binding DeviceId}"
                                    IsReadOnly="True"/>

                            </StackPanel>

                        </Grid>


                        <!-- CLIENT ID -->

                        <StackPanel Spacing="3">

                            <TextBlock
                                Text="Client ID"
                                FontSize="10"
                                Foreground="#555555"/>

                            <TextBox
                                Text="{Binding ClientId}"/>

                        </StackPanel>


                        <!-- CLIENT SECRET -->

                        <StackPanel Spacing="3">

                            <TextBlock
                                Text="Client Secret"
                                FontSize="10"
                                Foreground="#555555"/>

                            <TextBox
                                Text="{Binding ClientSecret}"
                                PasswordChar="●"/>

                        </StackPanel>


                        <!-- BOTÕES API -->

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="8">

                            <Button
                                Grid.Column="0"
                                Content="VINCULAR DISPOSITIVO"
                                Background="#171717"
                                Foreground="#FFC400"
                                Command="{Binding VincularDispositivoCommand}"/>

                            <Button
                                Grid.Column="1"
                                Content="TESTAR AUTENTICAÇÃO"
                                Background="#2563EB"
                                Foreground="White"
                                Command="{Binding TestarAutenticacaoCommand}"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- SQL SERVER                                        -->
                <!-- ================================================= -->

                <Border
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="14">

                    <StackPanel Spacing="8">


                        <!-- CABEÇALHO SQL -->

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock
                                Text="SQL Server"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#171717"
                                VerticalAlignment="Center"/>


                            <Border
                                Grid.Column="1"
                                Background="{Binding CorStatusSql}"
                                CornerRadius="5"
                                Padding="10,5">

                                <TextBlock
                                    Text="{Binding StatusSql}"
                                    Foreground="White"
                                    FontSize="10"
                                    FontWeight="Bold"/>

                            </Border>

                        </Grid>


                        <!-- SERVIDOR / BANCO -->

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="8">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Text="Servidor"
                                    FontSize="10"
                                    Foreground="#555555"/>

                                <TextBox
                                    Text="{Binding SqlServidor}"/>

                            </StackPanel>


                            <StackPanel
                                Grid.Column="1"
                                Spacing="3">

                                <TextBlock
                                    Text="Banco"
                                    FontSize="10"
                                    Foreground="#555555"/>

                                <ComboBox
                                    ItemsSource="{Binding BancosSql}"
                                    SelectedItem="{Binding BancoSelecionado}"/>

                            </StackPanel>

                        </Grid>


                        <!-- USUÁRIO / SENHA -->

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="8">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Text="Usuário"
                                    FontSize="10"
                                    Foreground="#555555"/>

                                <TextBox
                                    Text="{Binding SqlUsuario}"/>

                            </StackPanel>


                            <StackPanel
                                Grid.Column="1"
                                Spacing="3">

                                <TextBlock
                                    Text="Senha"
                                    FontSize="10"
                                    Foreground="#555555"/>

                                <TextBox
                                    Text="{Binding SqlSenha}"
                                    PasswordChar="●"/>

                            </StackPanel>

                        </Grid>


                        <!-- BOTÕES SQL / SINCRONIZAÇÃO -->

                        <Grid
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="8">

                            <Button
                                Grid.Column="0"
                                Content="TESTAR CONEXÃO"
                                Background="#FFC400"
                                Foreground="#171717"
                                Command="{Binding TestarConexaoSqlCommand}"/>


                            <Button
                                Grid.Column="1"
                                Content="TESTAR BANCO"
                                Background="#171717"
                                Foreground="#FFC400"
                                Command="{Binding TestarBancoSelecionadoCommand}"/>


                            <Button
                                Grid.Column="2"
                                Content="SINCRONIZAR"
                                Background="#2563EB"
                                Foreground="White"
                                Command="{Binding SincronizarApiCommand}"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- MENSAGEM / SALVAR                                  -->
                <!-- ================================================= -->

                <Grid
                    ColumnDefinitions="*,180"
                    ColumnSpacing="10">

                    <Border
                        Grid.Column="0"
                        Background="#FFF8D6"
                        BorderBrush="#FFC400"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10">

                        <TextBlock
                            Text="{Binding Mensagem}"
                            Foreground="#171717"
                            FontSize="11"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"/>

                    </Border>


                    <Button
                        Grid.Column="1"
                        Content="SALVAR CONFIGURAÇÃO"
                        Height="40"
                        Background="#16A34A"
                        Foreground="White"
                        FontWeight="Bold"
                        Command="{Binding SalvarConfiguracaoCommand}"/>

                </Grid>


                <!-- ================================================= -->
                <!-- INFORMAÇÃO                                        -->
                <!-- ================================================= -->

                <TextBlock
                    Text="As configurações serão reutilizadas automaticamente ao abrir o sistema."
                    FontSize="10"
                    Foreground="#777777"
                    HorizontalAlignment="Center"/>


            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
